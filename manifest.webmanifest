{
  "name": "Fitness Log",
  "short_name": "Fitness",
  "description": "Simple gym log with muscle map, strength levels and monthly progress.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
